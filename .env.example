# Variable names only. Copy to .env and fill in values locally.
# Never commit real values.

# Local Postgres (docker-compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Backend
# Format: postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME
DATABASE_URL=
# Same format. The database name must end in _test, or pytest refuses to run.
TEST_DATABASE_URL=
SESSION_TTL_HOURS=
SESSION_COOKIE_SECURE=

# Rate limits (optional; defaults in app/core/config.py)
RATE_LOGIN_PER_IP=
RATE_LOGIN_FAILURES_PER_EMAIL=
RATE_SIGNUP_PER_IP=
RATE_LOOKUP_PER_IP=
RATE_ENQUIRY_PER_IP=

# Uvicorn: addresses of trusted proxies whose X-Forwarded-For is believed (A-81).
# Default is this machine only (127.0.0.1,::1). In production, the proxy's address.
FORWARDED_ALLOW_IPS=
# Comma-separated origins allowed to send writes (log in, book, enquire). Must include
# the frontend's address, because browser requests carry it as Origin, for example
# http://localhost:3000 locally. Empty refuses every write from a browser.
CORS_ORIGINS=
BUSINESS_TIMEZONE=
HOLD_TTL_MINUTES=
BOOKING_HORIZON_DAYS=
MAX_STAY_NIGHTS=
MAX_UNITS_PER_BOOKING=
LOCK_TIMEOUT_MS=
PAYMENT_PROVIDER=
LOG_LEVEL=

# GST on room nights (optional; defaults in app/core/config.py)
GST_SLAB_THRESHOLD_PAISE=
GST_RATE_LOW_BP=
GST_RATE_HIGH_BP=

# Enquiry classifier. keyword (default, no model) or gemini.
CLASSIFIER_BACKEND=
CLASSIFIER_CONFIDENCE_THRESHOLD=
# Required when CLASSIFIER_BACKEND=gemini. A Google AI Studio API key. Never commit it.
LLM_API_KEY=
# Default gemini-3.5-flash-lite
LLM_MODEL=
# Default 8
LLM_TIMEOUT_SECONDS=
ENQUIRY_MAX_LENGTH=

# Frontend. Next.js reads env files from frontend/, not this folder, so set these in the
# frontend's environment (or frontend/.env.local). API_URL is the backend's base URL:
# browser calls to /api/* are forwarded there. Required for `next build` and
# `next start`; `npm run dev` defaults to http://localhost:8000.
API_URL=
